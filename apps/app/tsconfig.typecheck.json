{
  /* Wider type check than the production build: tsconfig.app.json deliberately
     excludes tests so `tsc -b && vite build` never compiles them. This config is
     the second pass that does, including e2e/ which sits outside src. */
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.typecheck.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src", "e2e"],
  "exclude": ["node_modules", "dist"]
}
