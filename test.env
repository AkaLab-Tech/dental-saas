# ============================================
# Test environment (committed on purpose)
# ============================================
# Loaded by apps/api/src/test/setup.ts before any database access.
# Contains local-only, non-secret values: never put real credentials here.
# Named "test.env" rather than ".env.test" so it is not swept up by the ".env*"
# rules that keep real environment files out of version control.
#
# Variables already present in the environment WIN over this file (dotenv does
# not override), so CI and explicit shell exports keep working unchanged.
#
# Bootstrap the database once with:
#   pnpm --filter @dental/database db:test:setup

NODE_ENV=test

# Must point at a database whose name looks like a test database (see the
# guard in apps/api/src/test/test-database.ts) — the suite truncates tables.
DATABASE_URL="postgresql://dental:localdev123@127.0.0.1:5432/dental_test?schema=public"

REDIS_URL="redis://:localdev123@localhost:6379"

JWT_SECRET=test-jwt-secret-minimum-32-characters-here
SETUP_KEY=test-setup-key-minimum-16-chars
