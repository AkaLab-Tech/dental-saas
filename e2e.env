# ============================================
# e2e environment (committed on purpose)
# ============================================
# Read only by apps/api's "dev:e2e" script, which apps/app/playwright.config.ts
# starts as the API webServer. Contains local-only, non-secret values that mean
# nothing outside the localhost containers on a development machine: never put
# real credentials here.
#
# Named "e2e.env" rather than a dot-prefixed variant — exactly as the existing
# test.env does, and for the same two reasons. .gitignore's environment-file
# rules ignore the dot-prefixed environment file, its ".local" sibling and the
# "*.local" pattern (there is no "*.env" rule, which is why test.env is
# tracked), and atelier's "atelier:block-env-read" hook protects the whole
# dot-prefixed glob — so a dot-prefixed name would be neither readable nor
# writable by the agents that need it.
#
# Variables already present in the environment WIN over this file (Node's
# --env-file does not override), so CI's job-level values and explicit shell
# exports keep working unchanged.
#
# PORT IS INTENTIONALLY ABSENT — do not add it. playwright.config.ts derives
# the URL it waits on from its own shell PORT, which this file never reaches.
# A PORT here would be honoured by the API and invisible to Playwright, so
# editing it would move the API only and time the webServer out after 120s.
# With PORT unset on both sides, Playwright's default and the API schema's
# default are both 5001 and stay aligned.

# Must NOT be "test": config/redis.ts returns a null client under
# NODE_ENV === 'test', which would silently run the rate limiter on
# MemoryStore instead of Redis.
NODE_ENV=development

# test.env's local credentials against the development database, since the e2e
# suite isolates by tenant rather than by database (it registers a fresh
# tenant per run).
DATABASE_URL="postgresql://dental:localdev123@127.0.0.1:5432/dental_saas?schema=public"

REDIS_URL="redis://:localdev123@localhost:6379"

# Taken from test.env rather than left to the schema default, which would log a
# "WARNING: Using default JWT_SECRET" line on every e2e boot.
JWT_SECRET=test-jwt-secret-minimum-32-characters-here

# The only variable with no default in apps/api/src/config/env.ts: its absence
# is what makes the API process exit with code 9.
SETUP_KEY=test-setup-key-minimum-16-chars
